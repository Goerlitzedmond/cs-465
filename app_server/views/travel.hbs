{{> header}}
<div id="content">
    <div id="travelinfo">
        <h1>Travel</h1>
        <div id="tabs">
            <ul>
                <li class="selected"><a href="#">Beaches</a></li>
                <li><a href="#">Cruises</a></li>
                <li><a href="#">Mountains</a></li>
            </ul>
        </div>
        <div id="tabcontent">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Length</th>
                        <th>Start</th>
                        <th>Resort</th>
                        <th>Per Person</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each trips}}
                    <tr>
                        <td>{{code}}</td>
                        <td>{{name}}</td>
                        <td>{{length}}</td>
                        <td>{{start}}</td>
                        <td>{{resort}}</td>
                        <td>${{perPerson}}</td>
                    </tr>
                    <tr>
                        <td colspan="6">{{description}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{> footer}}
